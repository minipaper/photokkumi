{
  "name": "photokkumi",
  "version": "0.1.0",
  "private": true,
  "description": "사진 한 장과 PNG 스티커를 로컬에서 합성하는 Electron 앱",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run typecheck && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.photokkumi.app",
    "productName": "PhotoKkumi",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "image-size": "2.0.4",
    "konva": "10.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "jpeg-js": "0.4.4",
    "node": "24.22.2",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
