{
  "name": "photokkumi",
  "version": "0.1.5",
  "private": true,
  "description": "내 스티커로 꾸미고, 다음 사진으로. 블로그·SNS에 올릴 사진에 스티커를 붙이고, 가릴 곳은 가리고, 크기를 맞춰 저장하는 Windows 앱",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run typecheck && npm run build && electron-builder --win nsis --x64 --publish never",
    "icon": "node scripts/make-icon.mjs",
    "shots": "node scripts/readme-shots.mjs"
  },
  "build": {
    "appId": "com.photokkumi.app",
    "productName": "PhotoKkumi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/default-stickers",
        "to": "default-stickers"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PhotoKkumi-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "minipaper",
        "repo": "photokkumi"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "image-size": "2.0.4",
    "konva": "10.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "jpeg-js": "0.4.4",
    "node": "24.22.2",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
